<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- List/form này cho model offer độc lập. Chúng cũng được tái sử dụng khi
         One2many cần mở offer ở dialog hoặc action stat button. -->
    <record id="estate_property_offer_view_list" model="ir.ui.view">
        <field name="name">estate.property.offer.list</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <!-- Màu chỉ biểu diễn status; status vẫn được bảo vệ trong Python. -->
            <list string="Offers" editable="bottom"
                  decoration-danger="status == 'refused'"
                  decoration-success="status == 'accepted'">
                <field name="price"/>
                <field name="partner_id"/>
                <field name="property_id"/>
                <field name="property_type_id"/>
                <field name="validity"/>
                <field name="date_deadline"/>
                <field name="status" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="estate_property_offer_view_form" model="ir.ui.view">
        <field name="name">estate.property.offer.form</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <form string="Offer">
                <header>
                    <button name="action_accept" type="object" string="Accept"
                            class="btn-primary" invisible="status != False"/>
                    <button name="action_refuse" type="object" string="Refuse"
                            invisible="status != False"/>
                </header>
                <sheet>
                    <group>
                        <field name="price"/>
                        <field name="partner_id"/>
                        <field name="property_id"/>
                        <field name="property_type_id" readonly="True"/>
                        <field name="validity"/>
                        <field name="date_deadline"/>
                        <field name="status"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action không đặt menu riêng; property type stat button gọi external ID này. -->
    <record id="estate_property_offer_action" model="ir.actions.act_window">
        <field name="name">Offers</field>
        <field name="res_model">estate.property.offer</field>
        <field name="view_mode">list,form</field>
        <!-- active_id do action context cung cấp: ID property type đang mở. -->
        <field name="domain">[('property_type_id', '=', active_id)]</field>
    </record>
</odoo>
