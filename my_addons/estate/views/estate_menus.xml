     <menuitem id="estate_menu_root" name="Real Estatet" sequence="10"/>

     <!-- Menu cấp hai chỉ là container; menu cấp ba có action mới mở view. -->
     <menuitem id="estate_menu_properties" name="Advertisements" parent="estate_menu_root" sequence="10"/>
