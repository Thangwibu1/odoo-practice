     <!-- Danh mục Type/Tag được tách khỏi luồng tạo tin đăng để dữ liệu master
         được quản lý nhất quán. -->
     <menuitem id="estate_menu_configuration" name="Configuration" parent="estate_menu_root" sequence="20"/>
     <menuitem id="estate_menu_property_types" name="Property Types" parent="estate_menu_configuration" action="estate_property_type_action" sequence="10"/>
     <menuitem id="estate_menu_property_tags" name="Property Tags" parent="estate_menu_configuration" action="estate_property_tag_action" sequence="20"/>
