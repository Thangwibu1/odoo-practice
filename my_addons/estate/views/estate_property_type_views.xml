<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Type list hỗ trợ sắp xếp thủ công qua sequence/handle. -->
    <record id="estate_property_type_view_list" model="ir.ui.view">
        <field name="name">estate.property.type.list</field>
        <field name="model">estate.property.type</field>
        <field name="arch" type="xml">
            <list string="Property Types">
                <!-- Drag handle ghi lại sequence; _order dùng sequence trước name. -->
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="estate_property_type_view_form" model="ir.ui.view">
        <field name="name">estate.property.type.form</field>
        <field name="model">estate.property.type</field>
        <field name="arch" type="xml">
            <form string="Property Type">
                <sheet>
                    <!-- button_box là vùng chuẩn dành cho stat buttons trên form. -->
                    <div class="oe_button_box" name="button_box">
                        <!-- Thuộc tính name bên dưới dùng cú pháp tham chiếu XML ID
                             đặc biệt; Odoo resolve nó thành database ID của action
                             khi load file. Không viết nguyên mẫu cú pháp trong
                             comment vì XML converter cũng xử lý nội dung arch. -->
                        <button name="%(estate_property_offer_action)d" type="action"
                                class="oe_stat_button" icon="fa-money">
                            <field name="offer_count" widget="statinfo" string="Offers"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <!-- Inline One2many đọc property_type_id ở model property. -->
                    <field name="property_ids">
                        <list>
                            <field name="name"/>
                            <field name="expected_price"/>
                            <field name="state"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_type_action" model="ir.actions.act_window">
        <field name="name">Property Types</field>
        <field name="res_model">estate.property.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
